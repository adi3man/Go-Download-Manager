{
  "manifest_version": 3,
  "name": "Go Download Manager Linker",
  "version": "1.2",
  "description": "Mengambil alih dan mengirim unduhan ke Go Download Manager",
  "permissions": [
    "contextMenus",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
